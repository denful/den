---
---

<div class="logo-animation">
  <canvas width="400" height="400" role="img" aria-label="den logo: circuit traces forming a house"></canvas>
</div>

<style>
  .logo-animation {
    width: min(70%, 20rem);
    height: auto;
    margin-inline: auto;
  }

  .logo-animation canvas {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1;
  }

  @media (min-width: 50rem) {
    .logo-animation {
      order: 2;
      width: min(100%, 25rem);
    }
  }
</style>

<script>
  // The den logo, drawn from its geometry: traces grow from the peak node,
  // split, and merge into the inner house; then pulses flow down to the
  // terminals. Coordinates are in the original 1024px artwork's space.
  type Pt = { x: number; y: number };
  type Sampled = { pts: Pt[]; dist: number[]; len: number };

  const canvas = document.querySelector('.logo-animation canvas') as HTMLCanvasElement | null;
  if (canvas) {
    const ctx = canvas.getContext('2d')!;
    const SIZE = 400;
    const dpr = Math.min(window.devicePixelRatio || 1, 2);
    canvas.width = SIZE * dpr;
    canvas.height = SIZE * dpr;

    const S = 0.74;
    const CX = 492;
    const CY = 400;
    const P = (x: number, y: number): Pt => ({ x: (x - CX) * S + SIZE / 2, y: (y - CY) * S + SIZE / 2 });

    const TOP = '#0aa2f5';
    const BOTTOM = '#6b5be6';
    const STROKE = 17 * S;
    const RING_R = 14 * S;
    const PEAK_R = 19 * S;

    // Rounded corners: each interior vertex becomes a sampled quadratic fillet.
    function smooth(raw: Pt[], radius: number): Pt[] {
      const out: Pt[] = [raw[0]];
      for (let i = 1; i < raw.length - 1; i++) {
        const a = raw[i - 1], v = raw[i], b = raw[i + 1];
        const la = Math.hypot(v.x - a.x, v.y - a.y);
        const lb = Math.hypot(b.x - v.x, b.y - v.y);
        const r = Math.min(radius, la / 2, lb / 2);
        const p0 = { x: v.x - ((v.x - a.x) / la) * r, y: v.y - ((v.y - a.y) / la) * r };
        const p2 = { x: v.x + ((b.x - v.x) / lb) * r, y: v.y + ((b.y - v.y) / lb) * r };
        for (let s = 0; s <= 8; s++) {
          const t = s / 8, u = 1 - t;
          out.push({ x: u * u * p0.x + 2 * u * t * v.x + t * t * p2.x, y: u * u * p0.y + 2 * u * t * v.y + t * t * p2.y });
        }
      }
      out.push(raw[raw.length - 1]);
      return out;
    }

    function sample(raw: [number, number][]): Sampled {
      const pts = smooth(raw.map(([x, y]) => P(x, y)), 16 * S);
      const dist = [0];
      for (let i = 1; i < pts.length; i++) dist.push(dist[i - 1] + Math.hypot(pts[i].x - pts[i - 1].x, pts[i].y - pts[i - 1].y));
      return { pts, dist, len: dist[dist.length - 1] };
    }

    function at(s: Sampled, d: number): Pt {
      if (d <= 0) return s.pts[0];
      if (d >= s.len) return s.pts[s.pts.length - 1];
      let i = 1;
      while (s.dist[i] < d) i++;
      const r = (d - s.dist[i - 1]) / (s.dist[i] - s.dist[i - 1]);
      return { x: s.pts[i - 1].x + (s.pts[i].x - s.pts[i - 1].x) * r, y: s.pts[i - 1].y + (s.pts[i].y - s.pts[i - 1].y) * r };
    }

    const peak = P(508, 183);
    const innerPeak = P(508, 287);
    const terminals = {
      leftOuter: P(298, 606),
      leftInner: P(404, 606),
      right: P(684, 606),
      eave: P(683, 408),
    };

    const geo = {
      outerL: sample([[508, 183], [350, 300], [338, 325], [338, 428]]),
      outerR: sample([[508, 183], [668, 300], [683, 325], [683, 408]]),
      legA: sample([[338, 428], [300, 470], [298, 490], [298, 606]]),
      legB: sample([[338, 428], [404, 490]]),
      innerL: sample([[508, 287], [410, 370], [404, 388], [404, 606]]),
      innerR: sample([[508, 287], [603, 370], [607, 388], [607, 432], [675, 496], [684, 514], [684, 606]]),
    };

    // Draw-phase schedule (ms). `from`/`to` trim the ends that sit under a ring.
    type Trace = { s: Sampled; t0: number; dur: number; from: number; to: number };
    const traces: Trace[] = [
      { s: geo.outerL, t0: 350, dur: 900, from: PEAK_R, to: 0 },
      { s: geo.outerR, t0: 350, dur: 850, from: PEAK_R, to: RING_R },
      { s: geo.legA, t0: 1250, dur: 550, from: 0, to: RING_R },
      { s: geo.legB, t0: 1250, dur: 380, from: 0, to: 0 },
      { s: geo.innerL, t0: 950, dur: 950, from: 0, to: RING_R },
      { s: geo.innerR, t0: 950, dur: 1350, from: 0, to: RING_R },
    ];
    type Ring = { p: Pt; r: number; t0: number };
    const rings: Ring[] = [
      { p: peak, r: PEAK_R, t0: 0 },
      { p: terminals.eave, r: RING_R, t0: 1200 },
      { p: terminals.leftOuter, r: RING_R, t0: 1800 },
      { p: terminals.leftInner, r: RING_R, t0: 1900 },
      { p: terminals.right, r: RING_R, t0: 2300 },
    ];
    const RING_DUR = 320;
    const DRAW_END = 2700;
    const FLOW_END = DRAW_END + 11000;
    const FADE_END = FLOW_END + 700;
    const CYCLE = FADE_END + 500;

    // Pulse routes, top to bottom. legB merges into the inner left wall at y=490.
    function concat(parts: { s: Sampled; from?: number }[]): Sampled {
      const pts: Pt[] = [];
      for (const { s, from = 0 } of parts) {
        const start = s.dist.findIndex((d) => d >= from);
        pts.push(...s.pts.slice(Math.max(0, start)));
      }
      const dist = [0];
      for (let i = 1; i < pts.length; i++) dist.push(dist[i - 1] + Math.hypot(pts[i].x - pts[i - 1].x, pts[i].y - pts[i - 1].y));
      return { pts, dist, len: dist[dist.length - 1] };
    }
    const mergeD = geo.innerL.dist[geo.innerL.pts.findIndex((p) => p.y >= P(0, 490).y)];
    const routes: { s: Sampled; end: Pt }[] = [
      { s: concat([{ s: geo.outerL, from: PEAK_R }, { s: geo.legA }]), end: terminals.leftOuter },
      { s: concat([{ s: geo.outerL, from: PEAK_R }, { s: geo.legB }, { s: geo.innerL, from: mergeD }]), end: terminals.leftInner },
      { s: concat([{ s: geo.outerR, from: PEAK_R }]), end: terminals.eave },
      { s: geo.innerL, end: terminals.leftInner },
      { s: geo.innerR, end: terminals.right },
    ];

    type Pulse = { route: (typeof routes)[number]; d: number; speed: number };
    type Burst = { p: Pt; age: number };
    let pulses: Pulse[] = [];
    let bursts: Burst[] = [];
    let nextPulse = 0;

    const ease = (x: number) => 1 - Math.pow(1 - Math.min(1, Math.max(0, x)), 3);

    let gradient: CanvasGradient;
    function makeGradient() {
      gradient = ctx.createLinearGradient(0, P(0, 170).y, 0, P(0, 620).y);
      gradient.addColorStop(0, TOP);
      gradient.addColorStop(1, BOTTOM);
    }

    function strokePart(s: Sampled, d0: number, d1: number) {
      if (d1 <= d0) return;
      ctx.beginPath();
      const a = at(s, d0);
      ctx.moveTo(a.x, a.y);
      for (let i = 0; i < s.pts.length; i++) {
        if (s.dist[i] <= d0) continue;
        if (s.dist[i] >= d1) break;
        ctx.lineTo(s.pts[i].x, s.pts[i].y);
      }
      const b = at(s, d1);
      ctx.lineTo(b.x, b.y);
      ctx.stroke();
    }

    function drawRing(r: Ring, k: number) {
      if (k <= 0) return;
      ctx.beginPath();
      ctx.arc(r.p.x, r.p.y, r.r, -Math.PI / 2, -Math.PI / 2 + Math.PI * 2 * ease(k));
      ctx.stroke();
    }

    function frame(t: number, dt: number) {
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      ctx.clearRect(0, 0, SIZE, SIZE);
      ctx.globalAlpha = t > FLOW_END ? Math.max(0, 1 - (t - FLOW_END) / (FADE_END - FLOW_END)) : 1;
      ctx.strokeStyle = gradient;
      ctx.lineWidth = STROKE;
      ctx.lineCap = 'round';
      ctx.lineJoin = 'round';

      for (const tr of traces) {
        const k = ease((t - tr.t0) / tr.dur);
        strokePart(tr.s, tr.from, tr.from + (tr.s.len - tr.from - tr.to) * k);
      }
      ctx.lineWidth = STROKE * 0.8;
      for (const r of rings) drawRing(r, (t - r.t0) / RING_DUR);

      // The inner house appears as a new scope: a brief expanding ring at its peak.
      const spawn = (t - 900) / 500;
      if (spawn > 0 && spawn < 1) {
        ctx.save();
        ctx.globalAlpha *= 1 - spawn;
        ctx.lineWidth = 2;
        ctx.beginPath();
        ctx.arc(innerPeak.x, innerPeak.y, 6 + spawn * 26, 0, Math.PI * 2);
        ctx.stroke();
        ctx.restore();
      }

      if (t > DRAW_END && t < FLOW_END && t >= nextPulse) {
        pulses.push({ route: routes[Math.floor(Math.random() * routes.length)], d: 0, speed: 0.16 + Math.random() * 0.08 });
        nextPulse = t + 380 + Math.random() * 520;
      }

      for (let i = pulses.length - 1; i >= 0; i--) {
        const p = pulses[i];
        p.d += p.speed * dt;
        if (p.d >= p.route.s.len - RING_R) {
          bursts.push({ p: p.route.end, age: 0 });
          pulses.splice(i, 1);
          continue;
        }
        const pos = at(p.route.s, p.d);
        ctx.save();
        // Pulses always sit on a coloured trace, so a white core reads in both themes.
        ctx.fillStyle = '#ffffff';
        ctx.shadowBlur = 14;
        ctx.shadowColor = pos.y < SIZE / 2 ? TOP : BOTTOM;
        ctx.beginPath();
        ctx.arc(pos.x, pos.y, STROKE * 0.32, 0, Math.PI * 2);
        ctx.fill();
        ctx.restore();
      }

      for (let i = bursts.length - 1; i >= 0; i--) {
        const b = bursts[i];
        b.age += dt / 600;
        if (b.age >= 1) {
          bursts.splice(i, 1);
          continue;
        }
        ctx.save();
        ctx.globalAlpha *= 1 - b.age;
        ctx.lineWidth = 2;
        ctx.strokeStyle = BOTTOM;
        ctx.beginPath();
        ctx.arc(b.p.x, b.p.y, RING_R + 4 + b.age * 18, 0, Math.PI * 2);
        ctx.stroke();
        ctx.restore();
      }
      ctx.globalAlpha = 1;
    }

    makeGradient();

    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      frame(DRAW_END, 0);
    } else {
      let start = performance.now();
      let last = start;
      let rafId = 0;
      let pausedAt = 0;

      const loop = (now: number) => {
        let t = now - start;
        if (t >= CYCLE) {
          start = now;
          t = 0;
          pulses = [];
          bursts = [];
          nextPulse = 0;
        }
        frame(t, Math.min(now - last, 50));
        last = now;
        rafId = requestAnimationFrame(loop);
      };
      rafId = requestAnimationFrame(loop);

      const visibility = new IntersectionObserver(([entry]) => {
        if (!entry.isIntersecting && rafId) {
          cancelAnimationFrame(rafId);
          rafId = 0;
          pausedAt = performance.now();
        } else if (entry.isIntersecting && !rafId) {
          const now = performance.now();
          start += now - pausedAt;
          last = now;
          rafId = requestAnimationFrame(loop);
        }
      });
      visibility.observe(canvas);

      document.addEventListener(
        'astro:before-swap',
        () => {
          cancelAnimationFrame(rafId);
          visibility.disconnect();
        },
        { once: true },
      );
    }
  }
</script>
